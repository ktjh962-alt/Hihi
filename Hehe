-- DODGE
-- GIỮ NGUYÊN LOGIC BẢN ĐÃ NÉ ĐƯỢC
--==================================================

local function GetDebrisZone()

    local folder =
        Workspace:FindFirstChild("RaidDebrisVfx")

    if not folder then
        return nil
    end

    return folder:FindFirstChild("DebrisZone")
end

-- Kiểm tra điểm có nằm trong toàn bộ DebrisZone
local function IsDangerous(pos, margin)

    local zone = GetDebrisZone()

    if not zone then
        return false
    end

    local ok, result = pcall(function()

        local cf = zone.CFrame
        local size = zone.Size / 2

        local localPos =
            cf:PointToObjectSpace(pos)

        return
            math.abs(localPos.X) <= size.X + margin and
            math.abs(localPos.Y) <= size.Y + margin and
            math.abs(localPos.Z) <= size.Z + margin

    end)

    return ok and result
end

--==================================================
-- SAFE POSITION
--==================================================

local function GetSafePosition(origin)

    local offsets = {

        Vector3.new(15, 5, 0),
        Vector3.new(-15, 5, 0),

        Vector3.new(0, 5, 15),
        Vector3.new(0, 5, -15),

        Vector3.new(20, 8, 20),
        Vector3.new(-20, 8, 20),

        Vector3.new(20, 8, -20),
        Vector3.new(-20, 8, -20),

    }

    for _, offset in ipairs(offsets) do

        local pos = origin + offset

        if not IsDangerous(
            pos,
            EmergencyMargin
        ) then

            return pos

        end
    end

    return origin + Vector3.new(0, 10, 0)
end

--==================================================
-- EMERGENCY DODGE
--==================================================

local function EmergencyDodge()

    local root = Root()

    if not root then
        return false
    end

    -- Chỉ né khi thực sự đang nằm trong vùng nguy hiểm
    if IsDangerous(
        root.Position,
        EmergencyMargin
    ) then

        local safe =
            GetSafePosition(root.Position)

        pcall(function()
            root.CFrame = CFrame.new(safe)
        end)

        task.wait(0.12)

        return true
    end

    return false
end

--==================================================
-- ABOVE CENTIPIDE
--==================================================

local function GetAbovePosition(enemy)

    local hrp =
        enemy:FindFirstChild("HumanoidRootPart")
        or enemy.PrimaryPart

    if not hrp then
        return nil
    end

    return hrp.Position +
        Vector3.new(0, AboveHeight, 0)
end

